#!/usr/bin/env python3
"""Keep the quiz pages' inlined stylesheet equal to q/assets/css/aic-chat.css.

  python3 scripts/inline-quiz-css          write the style blocks
  python3 scripts/inline-quiz-css --check  exit 1 if a page has drifted

The marker is <style data-aic-inline="q/assets/css/aic-chat.css">.
After #139 and #142 land, rebase this branch and run the writer again.
"""
from __future__ import annotations

import sys
from pathlib import Path

ROOT = Path(__file__).resolve().parents[1]
CSS_PATH = ROOT / "q/assets/css/aic-chat.css"
PAGES = [ROOT / "q/mihzur/index.html", ROOT / "q/ihud/index.html"]
OPEN = '<style data-aic-inline="q/assets/css/aic-chat.css">\n'
CLOSE = "</style>"


def css_text() -> str:
    text = CSS_PATH.read_text(encoding="utf-8")
    if not text.endswith("\n"):
        text += "\n"
    return text


def split_style(html: str, path: Path) -> tuple[str, str, str]:
    start = html.find(OPEN)
    if start < 0:
        raise SystemExit(f"{path}: missing {OPEN.strip()}")
    inner_at = start + len(OPEN)
    end = html.find(CLOSE, inner_at)
    if end < 0:
        raise SystemExit(f"{path}: style block is not closed")
    return html[:inner_at], html[inner_at:end], html[end:]


def main() -> int:
    check = "--check" in sys.argv
    css = css_text()
    drifted = []
    for path in PAGES:
        html = path.read_text(encoding="utf-8")
        head, inner, tail = split_style(html, path)
        if inner == css:
            continue
        drifted.append(path.relative_to(ROOT).as_posix())
        if not check:
            path.write_text(head + css + tail, encoding="utf-8")
    if check and drifted:
        print("Inlined quiz CSS does not match q/assets/css/aic-chat.css:", file=sys.stderr)
        for name in drifted:
            print(f"  {name}", file=sys.stderr)
        print("Run: python3 scripts/inline-quiz-css", file=sys.stderr)
        return 1
    if not check and drifted:
        print("updated " + ", ".join(drifted))
    elif check:
        print("quiz CSS inline matches aic-chat.css")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
