# Preview upload exclusions. Same set as .github/workflows/pages-artifact.yml.
# Production menifa.org is GitHub Pages; this file only affects Vercel.
# Percent-encoded ".md" paths bypass the vercel.json routes rule and would
# otherwise return the file. Keeping the files out of the deployment makes
# those paths 404 with no body.
#
# vercel.json is NOT ignored. Vercel reads it for redirects, headers,
# cleanUrls, and trailingSlash. It is not a public page.
#
# No markdown file is intentionally public (none are linked from sitemap,
# robots, llms, rss, or HTML).

*.md
docs/
social/
.github/
tools/
scripts/
tests/
redirects.csv
.gitignore
.vercelignore
.env
.env.*
*.secret
.pat

# noindex work files. They stay in the repo and are not uploaded.
# Same 17 paths the Pages artifact excludes, plus the root screenshot.
/preview*.html
/mockups.html
/mockups/
/index-v2.html
/assets/v2.css
/assets/v2.js
/assets/premium.*
/1.jpeg
