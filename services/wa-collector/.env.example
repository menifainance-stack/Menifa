# ===== WAHA =====
WAHA_API_KEY=change-me-long-random          # openssl rand -hex 24
WAHA_DASHBOARD_USERNAME=admin
WAHA_DASHBOARD_PASSWORD=change-me
WAHA_ENGINE=GOWS                            # GOWS | NOWEB | WEBJS

# ===== collector =====
WA_HOOK_SECRET=change-me-another-random     # מאמת שה-webhook הגיע מ-WAHA (HMAC) או עם header X-Hook-Secret
WA_GROUPS=                                  # ריק = כל הקבוצות. או רשימה: 1203630xxxx@g.us,יועצי משכנתאות ישראל
DIGEST_HOUR=8
DIGEST_MINUTE=30

# ===== Claude =====
ANTHROPIC_API_KEY=sk-ant-...
DIGEST_MODEL=claude-opus-5

# ===== מסירה (לפחות אחד) =====
DIGEST_EMAIL_TO=menifainance@gmail.com
RESEND_API_KEY=                             # אותו מפתח כמו ב-GitHub Secrets של הריפו
# או Gmail עם App Password:
SMTP_USER=
SMTP_PASS=
